          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/company/delete/{{companyId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns success', function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
