              "raw": "{\n  \"Id\": \"{{companyId}}\",\n  \"Company_code\": \"{{companyCode}}\",\n  \"Company_name\": \"{{companyName}}\",\n  \"Address\": \"{{companyAddress}}\",\n  \"Phone_number\": \"{{companyPhone}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/company/save/"
          },
          "event": [
            {
              "listen": "test",
